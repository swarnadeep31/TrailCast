{
  "name": "trailcast",
  "version": "0.1.0",
  "private": true,
  "description": "Adventure videos with the map beside them.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "bun --filter './server' --filter './client' dev",
    "test": "bun --filter './server' test && bun --filter './client' test",
    "build": "bun --filter './client' build",
    "typecheck": "bun --filter './server' typecheck && bun --filter './client' typecheck"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.5"
}
